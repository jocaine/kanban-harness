# Kanban Harness Configuration
# Copy this file to .env and fill in your values

# Server
PORT=8000
HOST=0.0.0.0

# Database (relative path from project root)
DB_PATH=data/kanban.db

# LLM API — 支持 OpenAI / Anthropic / 任何兼容中转站
# hermes 和 fallback chat 都从这里读取
API_KEY=your-api-key-here
API_BASE_URL=http://your-llm-proxy:8317/v1

# Model (hermes 和 chat 使用的模型名)
CHAT_MODEL=claude-sonnet-4-6

# Claude CLI 专用（Coach-Dev 使用）
# 如果你的 API_KEY 和 API_BASE_URL 已经兼容 Anthropic 格式，这里可以复用
ANTHROPIC_AUTH_TOKEN=${API_KEY}
ANTHROPIC_BASE_URL=http://your-llm-proxy:8317/

# Hermes 配置（可选，有默认值）
# HERMES_MODEL=claude-sonnet-4-6
# HERMES_PROVIDER=openai
# HERMES_TOOLSETS=hermes-cli

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
