# Kanban Harness Configuration

# Server
PORT=8000
HOST=0.0.0.0

# Database (relative path from project root)
DB_PATH=data/kanban.db

# LLM API — 只需填这两个，支持 OpenAI / Anthropic / 任何兼容中转站
# hermes 和 fallback chat 都从这里读取
API_KEY=sk-b707a241f4344c7d8532660210a4b8e2
API_BASE_URL=http://192.168.3.15:8317/v1

# Model (hermes 使用的模型名)
CHAT_MODEL=claude-opus-4-6

# Web Search — Tavily API (免费 1000次/月, https://tavily.com)
# 填入后 Industry agent 的 web_search 自动切换为 Tavily 后端
# 留空则 web_search 不可用（DuckDuckGo 被墙）
TAVILY_API_KEY=tvly-test123

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
